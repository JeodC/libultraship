@prism(type='fragment', name='Fast3D Noise', version='1.0.0', description='Hash-based random() used for N64 noise; expects frame_count/noise_scale uniforms', author='Fast3D')
    float random(in highp vec3 value) {
        highp uvec3 p = uvec3(ivec3(value));
        highp uint h = p.x * 1597334677u ^ p.y * 3812015801u ^ p.z * 2654435761u;
        h ^= h >> 16u; h *= 2246822519u;
        h ^= h >> 13u; h *= 3266489917u;
        h ^= h >> 16u;
        return float(h >> 22u) / 1024.0;
    }
